# REQUIRED

BACKEND_URL=http://localhost:4174
FRONTEND_URL=http://localhost:5173
VALKEY_URL=valkey://localhost:6379
JAEGER_URL=http://localhost:4318
JWT_SECRET_KEY=jwt_secret

PG_USER=postgres
PG_PASS=postgrespass
PG_HOST=localhost
PG_DB=segoya_data

# OPTIONAL

# if not set - default is production
ENV_MODE=development

# socks5 proxy credentials for external HTTP requests, including CAPTCHA verification
PROXY_ADDR=
PROXY_USERNAME=
PROXY_PASSWORD=

# cloudflare credentials
CLOUDFLARE_AVATAR_BUCKET=
CLOUDFLARE_BUCKETS_ACCESS_KEY=
CLOUDFLARE_BUCKETS_SECRET_KEY=
CLOUDFLARE_ACCOUNT_ID=

# CAPTCHA provider: cap (default when omitted or empty), yandex or turnstile
# Empty secret disables CAPTCHA only in development. All other modes require a secret.
# A configured secret enables verification even on localhost.
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=
# Required for cap when a secret is set; full URL including the site key and /siteverify
# Local Go process: http://localhost:3000/<site-key>/siteverify
# Docker Compose backend: http://cap:3000/<site-key>/siteverify
CAPTCHA_VERIFY_URL=

# discord oauth credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# yandex oauth credentials
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
